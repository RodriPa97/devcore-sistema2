# Copiá este archivo como ".env" (sin el ".example") y completá los valores.

# Base de datos SQLite local (no hace falta instalar nada aparte, es un archivo).
DATABASE_URL="file:./dev.db"

# Clave secreta para firmar las sesiones. Generá una propia (cualquier texto
# largo y random sirve) y no la compartas. Ejemplo para generarla en la
# terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="cambiar-esto-por-un-texto-largo-y-random"

# URL donde corre la app en desarrollo. No hace falta tocarlo.
NEXTAUTH_URL="http://localhost:3000"

# Datos del usuario administrador que se crea la primera vez que corrés
# "npm run seed". Cambiá el email y la contraseña antes de usarlo en serio.
ADMIN_EMAIL="admin@devcore.com"
ADMIN_PASSWORD="CambiarEsta123!"
