# Copiá este archivo como ".env" (sin el ".example") y completá los valores.

# PostgreSQL local de Docker. En staging/producción usar una base Neon separada.
DATABASE_URL="postgresql://devcore:devcore@localhost:5432/devcore?schema=public"

# Clave secreta para firmar las sesiones. Generala con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=""

# URL donde corre la app en desarrollo. No hace falta tocarlo.
NEXTAUTH_URL="http://localhost:3000"

# Datos obligatorios para crear el administrador inicial con "npm run seed".
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Opcional en desarrollo. En staging/producción usar Upstash Redis para que
# el rate limiting sea compartido entre instancias serverless.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
